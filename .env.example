# IntentProof Tx Guard demo/dev environment.
# Never put production secrets, real mnemonics, private keys, or generated wallets here.
# Examples, Local Token Core Vault, and Token Core Lab work without any values in this file.

# Optional public WalletConnect/Reown project id for Protect Wallet live pairing.
# This value is browser-visible by design. It is not a secret.
# Without it, the app shows setup-required for live DApp pairing while Examples,
# Local Token Core Vault, and Token Core Lab keep working. imToken Web uses
# @consenlabs/imtoken-connect and does not require a WalletConnect project id.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: one public Alchemy key for RPC fallback and live request
# alchemy_simulateAssetChanges previews. This value is browser-visible, so use a
# disposable app key with strict domain allowlists for hosted deployments.
# Without this key, live request rating still uses open RPC eth_call/estimateGas
# dry-runs and local decode/policy evidence.
# Apply here: https://dashboard.alchemy.com/apps
VITE_ALCHEMY_API_KEY=

# Optional: Etherscan V2 key for Sepolia/Base Sepolia and mainnet
# contract source/ABI lookup.
# Apply here: https://etherscan.io/apidashboard
VITE_ETHERSCAN_API_KEY=

# Optional local/dev Tenderly Node RPC key for richer simulation.
# Warning: this VITE_* value is browser-visible. Do not deploy it to hosted demos
# unless it is explicitly disposable and accepted as public.
# Apply here: https://dashboard.tenderly.co/<ACCOUNT_SLUG>/<PROJECT_SLUG>/nodes
VITE_TENDERLY_NODE_ACCESS_KEY=

# Optional server/CLI-only Tenderly REST settings for public shareable simulation links
# (all three must be set together). These are intentionally not VITE_* because the
# access token is a server-side credential. Do not expose these through browser env.
# Never set VITE_TENDERLY_ACCESS_TOKEN; that would publish the REST token.
# Apply here: https://dashboard.tenderly.co/<ACCOUNT_SLUG>/<PROJECT_SLUG>/settings
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
TENDERLY_ACCESS_TOKEN=

# Optional: CLI wallet storage root. Defaults to ./.tokencore-cli
TOKENCORE_CLI_HOME="./.tokencore-cli"

# Optional: CLI password for non-interactive scripts. Prefer setting in shell env,
# CI secret, or a secure secret manager instead of storing long-term in files.
TOKENCORE_CLI_PASSWORD=

# AI summary (Traditional Chinese). Providers are tried in order:
#   Gemini → Groq → local rule-based fallback (always available, no key needed).
# Warning: VITE_* vars are exposed to the browser bundle. Use disposable demo/dev
# keys only, and leave them empty for hosted builds unless intentionally public.
# Do not expose OpenAI/server-side secrets through VITE_* browser variables.

# Optional local-only browser AI. These VITE_* values are public in the browser,
# and IntentProof keeps remote AI off unless the user opts in for the session.
# Do not set these in hosted builds unless the keys are intentionally public.
#
# Recommended first choice — free tier (1500 RPD, gemini-2.0-flash).
# Tip: create a NEW Google Cloud Project for a fresh daily quota.
# Apply here: https://aistudio.google.com/api-keys
VITE_GEMINI_API_KEY=

# Recommended second choice — most generous free tier (1000 RPD for llama-3.3-70b,
# or switch model to llama-3.1-8b-instant for 14400 RPD at slightly lower quality).
# Backed by Meta's open-source Llama models; OpenAI-compatible API.
# Free account, no credit card needed. Apply here: https://console.groq.com/keys
VITE_GROQ_API_KEY=

{
  "name": "intentproof-tx-guard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc -b",
    "build:ui": "vite build && node scripts/copy-spa-routes.mjs",
    "build": "npm run typecheck && npm run build:ui",
    "cli": "node --import tsx/esm src/cli.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run src/test --exclude \"src/test/cli/**\"",
    "test:cli": "vitest run src/test/cli",
    "test:smoke:chains": "vitest run src/test/lib/chain-compatibility-smoke.test.ts",
    "test:ui": "vitest run src/test/ui/app-smoke.test.tsx src/test/ui/error-boundary.test.tsx src/test/ui/demo-dapp.test.tsx src/test/ui/top-dapp-e2e-harness.test.tsx --passWithNoTests",
    "test:e2e:dapps": "vitest run src/test/ui/top-dapp-e2e-harness.test.tsx",
    "test": "npm run test:unit && npm run test:cli",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:cli && npm run test:smoke:chains && npm run build:ui",
    "audit:high": "npm audit --audit-level=high",
    "secrets:check": "node scripts/check-secrets.mjs",
    "abi:keystone": "node scripts/generate-keystone-abi-registry.mjs"
  },
  "dependencies": {
    "@consenlabs/tcx-wasm": "^0.8.0",
    "@reown/walletkit": "^1.5.5",
    "@walletconnect/core": "^2.23.9",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.3"
  }
}
